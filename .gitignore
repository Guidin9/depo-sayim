# Makineye ozel - asla depoya girmez, USB ile de tasinmamali:
# sanal ortam kendi Python'unun MUTLAK yolunu icinde tasir, node_modules
# platforma ozel ikili dosyalar icerir, tsbuildinfo mutlak yol tutar.
.venv/
web/node_modules/
web/dist/
web/tsconfig.tsbuildinfo
__pycache__/
*.pyc
.pytest_cache/

# Derleme ciktisi - kurulum.bat uretiyor
app/static/

